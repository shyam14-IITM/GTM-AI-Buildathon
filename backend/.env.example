# ==========================================
# SDR Buildathon - Environment Configuration
# ==========================================

# 1. Database (Supabase)
# For Supabase with SQLAlchemy/asyncpg, use the connection pooling URL (usually port 6543)
# and disable the IPv6 'supavisor' pooler if needed, or use the direct connection string.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres.your_project_ref:your_password@aws-0-region.pooler.supabase.com:6543/postgres"

# 2. Authentication & Security
# Generate a secure random string (e.g. using `openssl rand -hex 32`)
SECRET_KEY="your-super-secret-random-jwt-key"
# Used to authenticate API calls from DronaHQ
DRONAHQ_API_KEY="your-secure-dronahq-api-key"

# 3. Third-Party APIs
# Groq for fast LLM inference (requires OpenAI compatible endpoint)
GROQ_API_KEY="gsk_your_groq_api_key_here"
# Resend for sending emails
RESEND_API_KEY="re_your_resend_api_key_here"

# 4. Application Configuration
# Comma-separated list of allowed origins for CORS. 
# Include your Vercel/Render frontend URL for production!
ALLOWED_ORIGINS="http://localhost:5173,https://your-production-frontend.com"

# Optional: Override email address to send all generated emails to a specific inbox during testing/demo
DEMO_EMAIL_OVERRIDE="your_email@example.com"
